 arch/x86/net/bpf_jit_comp.c                   |  59 ++++++++
 include/linux/filter.h                        |   5 +
 kernel/bpf/helpers.c                          |  36 +++++
 kernel/bpf/verifier.c                         |  40 +++++
 .../selftests/bpf/prog_tests/scalar_bitops.c  |   8 +
 .../selftests/bpf/progs/scalar_bitops.c       | 141 ++++++++++++++++++
 6 files changed, 289 insertions(+)
 create mode 100644 tools/testing/selftests/bpf/prog_tests/scalar_bitops.c
 create mode 100644 tools/testing/selftests/bpf/progs/scalar_bitops.c

diff --git a/arch/x86/net/bpf_jit_comp.c b/arch/x86/net/bpf_jit_comp.c
index ea74ff1..9778218 100644
--- a/arch/x86/net/bpf_jit_comp.c
+++ b/arch/x86/net/bpf_jit_comp.c
@@ -1628,6 +1628,40 @@ static void emit_priv_frame_ptr(u8 **pprog, void __percpu *priv_frame_ptr)
 	*pprog = prog;
 }
 
+static bool emit_scalar_bitop(u8 **pprog, const u8 *func)
+{
+#ifdef CONFIG_BPF_SYSCALL
+	u8 *prog = *pprog;
+	u8 opcode;
+
+	if (func == (const u8 *)bpf_mulhi64) {
+		/* r0 = mulhi(r1, r2), clobbering only call-scratch RAX/RDX. */
+		EMIT3(0x48, 0x89, 0xf8); /* mov RAX, RDI */
+		EMIT3(0x48, 0xf7, 0xe6); /* mul RSI */
+		EMIT3(0x48, 0x89, 0xd0); /* mov RAX, RDX */
+		*pprog = prog;
+		return true;
+	}
+
+	if (func == (const u8 *)bpf_ctz64 && boot_cpu_has(X86_FEATURE_BMI1))
+		opcode = 0xbc;
+	else if (func == (const u8 *)bpf_popcnt64 && boot_cpu_has(X86_FEATURE_POPCNT))
+		opcode = 0xb8;
+	else if (func == (const u8 *)bpf_clz64 && boot_cpu_has(X86_FEATURE_ABM))
+		opcode = 0xbd;
+	else
+		return false;
+
+	/* r0 = bitop(r1): RAX = bitop(RDI), normal BPF call ABI. */
+	EMIT4(0xf3, 0x48, 0x0f, opcode);
+	EMIT1(0xc7);
+	*pprog = prog;
+	return true;
+#else
+	return false;
+#endif
+}
+
 #define INSN_SZ_DIFF (((addrs[i] - addrs[i - 1]) - (prog - temp)))
 
 #define __LOAD_TCC_PTR(off)			\
@@ -2600,6 +2634,8 @@ populate_extable:
 
 			/* call */
 		case BPF_JMP | BPF_CALL: {
+			bool scalar_fastcall = false;
+
 			func = (u8 *) __bpf_call_base + imm32;
 			if (src_reg == BPF_PSEUDO_CALL && tail_call_reachable) {
 				LOAD_TAIL_CALL_CNT_PTR(stack_depth);
@@ -2607,6 +2643,23 @@ populate_extable:
 			}
 			if (!imm32)
 				return -EINVAL;
+			if (src_reg == BPF_PSEUDO_KFUNC_CALL &&
+			    emit_scalar_bitop(&prog, func))
+				break;
+#ifdef CONFIG_BPF_SYSCALL
+			if (src_reg == BPF_PSEUDO_KFUNC_CALL &&
+			    (func == (const u8 *)bpf_ctz64 ||
+			     func == (const u8 *)bpf_popcnt64 ||
+			     func == (const u8 *)bpf_clz64)) {
+				/* The C fallback must honor unary KF_FASTCALL too. */
+				EMIT1(0x56); /* push rsi (BPF R2) */
+				EMIT1(0x52); /* push rdx (BPF R3) */
+				EMIT1(0x51); /* push rcx (BPF R4) */
+				EMIT2(0x41, 0x50); /* push r8 (BPF R5) */
+				ip += 5;
+				scalar_fastcall = true;
+			}
+#endif
 			if (priv_frame_ptr) {
 				push_r9(&prog);
 				ip += 2;
@@ -2616,6 +2669,12 @@ populate_extable:
 				return -EINVAL;
 			if (priv_frame_ptr)
 				pop_r9(&prog);
+			if (scalar_fastcall) {
+				EMIT2(0x41, 0x58); /* pop r8 */
+				EMIT1(0x59); /* pop rcx */
+				EMIT1(0x5a); /* pop rdx */
+				EMIT1(0x5e); /* pop rsi */
+			}
 			break;
 		}
 
diff --git a/include/linux/filter.h b/include/linux/filter.h
index e0e83bf..d8fd3ec 100644
--- a/include/linux/filter.h
+++ b/include/linux/filter.h
@@ -1264,6 +1264,11 @@ struct bpf_prog *bpf_patch_insn_single(struct bpf_prog *prog, u32 off,
 				       const struct bpf_insn *patch, u32 len);
 
 #ifdef CONFIG_BPF_SYSCALL
+u64 bpf_ctz64(u64 x);
+u64 bpf_popcnt64(u64 x);
+u64 bpf_clz64(u64 x);
+u64 bpf_mulhi64(u64 x, u64 y);
+
 struct bpf_prog *bpf_patch_insn_data(struct bpf_verifier_env *env, u32 off,
 				     const struct bpf_insn *patch, u32 len);
 struct bpf_insn_aux_data *bpf_dup_insn_aux_data(struct bpf_verifier_env *env);
diff --git a/kernel/bpf/helpers.c b/kernel/bpf/helpers.c
index 61805d8..c6015f3 100644
--- a/kernel/bpf/helpers.c
+++ b/kernel/bpf/helpers.c
@@ -4771,6 +4771,32 @@ __bpf_kfunc int bpf_timer_cancel_async(struct bpf_timer *timer)
 	}
 }
 
+/* Scalar bitops keep identical semantics on inline and fallback call paths. */
+__bpf_kfunc u64 bpf_ctz64(u64 x)
+{
+	return x ? __ffs64(x) : 64;
+}
+
+__bpf_kfunc u64 bpf_popcnt64(u64 x)
+{
+	return hweight64(x);
+}
+
+__bpf_kfunc u64 bpf_clz64(u64 x)
+{
+	return 64 - fls64(x);
+}
+
+__bpf_kfunc u64 bpf_mulhi64(u64 x, u64 y)
+{
+	u64 x0 = (u32)x, x1 = x >> 32, y0 = (u32)y, y1 = y >> 32;
+	u64 mid = x1 * y0 + ((x0 * y0) >> 32);
+	u64 carry = mid >> 32;
+
+	mid = (u32)mid + x0 * y1;
+	return x1 * y1 + carry + (mid >> 32);
+}
+
 __bpf_kfunc_end_defs();
 
 static void bpf_task_work_cancel_scheduled(struct irq_work *irq_work)
@@ -4971,6 +4997,16 @@ BTF_ID_FLAGS(func, bpf_task_work_schedule_resume, KF_IMPLICIT_ARGS)
 BTF_ID_FLAGS(func, bpf_dynptr_from_file)
 BTF_ID_FLAGS(func, bpf_dynptr_file_discard, KF_RELEASE)
 BTF_ID_FLAGS(func, bpf_timer_cancel_async)
+#if defined(CONFIG_X86_64) && defined(CONFIG_BPF_JIT)
+BTF_ID_FLAGS(func, bpf_ctz64, KF_FASTCALL)
+BTF_ID_FLAGS(func, bpf_popcnt64, KF_FASTCALL)
+BTF_ID_FLAGS(func, bpf_clz64, KF_FASTCALL)
+#else
+BTF_ID_FLAGS(func, bpf_ctz64)
+BTF_ID_FLAGS(func, bpf_popcnt64)
+BTF_ID_FLAGS(func, bpf_clz64)
+#endif
+BTF_ID_FLAGS(func, bpf_mulhi64)
 BTF_KFUNCS_END(common_btf_ids)
 
 static const struct btf_kfunc_id_set common_kfunc_set = {
diff --git a/kernel/bpf/verifier.c b/kernel/bpf/verifier.c
index ccf735d..288df3b 100644
--- a/kernel/bpf/verifier.c
+++ b/kernel/bpf/verifier.c
@@ -11235,6 +11235,9 @@ enum special_kfunc_type {
 	KF_bpf_session_is_return,
 	KF_bpf_stream_vprintk,
 	KF_bpf_stream_print_stack,
+	KF_bpf_ctz64,
+	KF_bpf_popcnt64,
+	KF_bpf_clz64,
 };
 
 BTF_ID_LIST(special_kfunc_list)
@@ -11332,6 +11335,9 @@ BTF_ID_UNUSED
 #endif
 BTF_ID(func, bpf_stream_vprintk)
 BTF_ID(func, bpf_stream_print_stack)
+BTF_ID(func, bpf_ctz64)
+BTF_ID(func, bpf_popcnt64)
+BTF_ID(func, bpf_clz64)
 
 static bool is_bpf_obj_new_kfunc(u32 func_id)
 {
@@ -13085,6 +13091,31 @@ static int check_special_kfunc(struct bpf_verifier_env *env, struct bpf_kfunc_ca
 
 static int check_return_code(struct bpf_verifier_env *env, int regno, const char *reg_name);
 
+static int scalar_bitop_return_max(struct bpf_verifier_env *env,
+				   const struct bpf_kfunc_call_arg_meta *meta,
+				   int *max)
+{
+	struct bpf_reg_state *arg = &cur_regs(env)[BPF_REG_1];
+	bool scan;
+	int err;
+
+	if (meta->btf != btf_vmlinux)
+		return 0;
+	scan = meta->func_id == special_kfunc_list[KF_bpf_ctz64] ||
+	       meta->func_id == special_kfunc_list[KF_bpf_clz64];
+	if (!scan && meta->func_id != special_kfunc_list[KF_bpf_popcnt64])
+		return 0;
+	*max = 64;
+	if (scan && (reg_umin(arg) > 0 || arg->var_off.value)) {
+		/* The derived bound must retain its input dependency during pruning. */
+		err = mark_chain_precision(env, BPF_REG_1);
+		if (err)
+			return err;
+		*max = 63;
+	}
+	return 0;
+}
+
 static int check_kfunc_call(struct bpf_verifier_env *env, struct bpf_insn *insn,
 			    int *insn_idx_p)
 {
@@ -13099,6 +13130,7 @@ static int check_kfunc_call(struct bpf_verifier_env *env, struct bpf_insn *insn,
 	const struct btf_param *args;
 	u32 i, nargs, ptr_type_id;
 	struct btf *desc_btf;
+	int scalar_max = -1;
 	int id;
 
 	/* skip for now, but return error when we find this in fixup_kfunc_call */
@@ -13165,6 +13197,9 @@ static int check_kfunc_call(struct bpf_verifier_env *env, struct bpf_insn *insn,
 	err = check_kfunc_args(env, &meta, insn_idx);
 	if (err < 0)
 		return err;
+	err = scalar_bitop_return_max(env, &meta, &scalar_max);
+	if (err)
+		return err;
 
 	if ((is_bpf_obj_drop_kfunc(meta.func_id) ||
 	     is_bpf_percpu_obj_drop_kfunc(meta.func_id)) && (is_tracing_prog_type(prog_type) ||
@@ -13314,6 +13349,11 @@ static int check_kfunc_call(struct bpf_verifier_env *env, struct bpf_insn *insn,
 
 	if (btf_type_is_scalar(t)) {
 		mark_reg_unknown(env, regs, BPF_REG_0);
+		if (scalar_max >= 0) {
+			regs[BPF_REG_0].var_off = tnum_range(0, scalar_max);
+			reg_set_urange64(&regs[BPF_REG_0], 0, scalar_max);
+			reg_bounds_sync(&regs[BPF_REG_0]);
+		}
 		if (meta.btf == btf_vmlinux && (meta.func_id == special_kfunc_list[KF_bpf_res_spin_lock] ||
 		    meta.func_id == special_kfunc_list[KF_bpf_res_spin_lock_irqsave]))
 			__mark_reg_const_zero(env, &regs[BPF_REG_0]);
diff --git a/tools/testing/selftests/bpf/prog_tests/scalar_bitops.c b/tools/testing/selftests/bpf/prog_tests/scalar_bitops.c
