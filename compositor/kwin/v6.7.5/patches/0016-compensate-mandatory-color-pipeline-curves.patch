+void DrmTest::testNonBypassableNamedTransferFunctions()
+{
+    const auto mockGpu = findPrimaryDevice(0);
+    QVERIFY(mockGpu);
+    const auto session = Session::create(Session::Type::Noop);
+    const auto backend = std::make_unique<DrmBackend>(session.get());
+    auto gpu = std::make_unique<DrmGpu>(backend.get(), mockGpu->fd, DrmDevice::open(mockGpu->devNode));
+
+    using Feature = DrmAbstractColorOp::Feature;
+    const auto matrixFeatures = DrmAbstractColorOp::Features{Feature::Bypass} | Feature::MultipleOps;
+    const auto lutFeatures = DrmAbstractColorOp::Features{Feature::Bypass} | Feature::MultipleOps;
+
+    // This is the relevant center of NVIDIA Full:
+    // programmable matrix -> mandatory PQ^-1 -> programmable LUT ->
+    // mandatory PQ -> programmable matrix.
+    auto tailMatrix = std::make_unique<TestColorOp>(nullptr, TestColorOp::Kind::Matrix, matrixFeatures);
+    auto pqEotf = std::make_unique<TestColorOp>(tailMatrix.get(), TestColorOp::Kind::PqEotf, DrmAbstractColorOp::Features{});
+    auto lut = std::make_unique<TestColorOp>(pqEotf.get(), TestColorOp::Kind::Lut, lutFeatures);
+    auto pqInverseEotf = std::make_unique<TestColorOp>(lut.get(), TestColorOp::Kind::PqInverseEotf, DrmAbstractColorOp::Features{});
+    auto headMatrix = std::make_unique<TestColorOp>(pqInverseEotf.get(), TestColorOp::Kind::Matrix, matrixFeatures);
+
+    constexpr double minimum = -0.564198375;
+    constexpr double maximum = 232.232208252;
+    ColorPipeline requested(ValueRange{.min = minimum, .max = maximum}, ColorspaceType::LinearRGB);
+    requested.addInverseTransferFunction(TransferFunction(TransferFunction::gamma22, 0, 325.125081539), ColorspaceType::NonLinearRGB);
+
+    QVERIFY(headMatrix->matchPipeline(gpu.get(), requested));
+    QVERIFY(!pqInverseEotf->m_bypassed);
+    QVERIFY(!pqEotf->m_bypassed);
+    QVERIFY(!pqInverseEotf->m_invalidBypass);
+    QVERIFY(!pqEotf->m_invalidBypass);
+    QCOMPARE(pqInverseEotf->m_programmed.size(), 1);
+    QCOMPARE(pqEotf->m_programmed.size(), 1);
+    QCOMPARE(lut->m_programmed.size(), 3);
+
+    const auto firstPq = std::get_if<InverseColorTransferFunction>(&pqInverseEotf->m_programmed.front());
+    QVERIFY(firstPq);
+    QCOMPARE(firstPq->tf.minLuminance, 0.0);
+    QCOMPARE(firstPq->tf.maxLuminance, 125.0);
+    const auto lastPq = std::get_if<ColorTransferFunction>(&pqEotf->m_programmed.front());
+    QVERIFY(lastPq);
+    QCOMPARE(lastPq->tf.minLuminance, 0.0);
+    QCOMPARE(lastPq->tf.maxLuminance, 125.0);
+
+    const std::array<TestColorOp *, 5> hardware = {
+        headMatrix.get(),
+        pqInverseEotf.get(),
+        lut.get(),
+        pqEotf.get(),
+        tailMatrix.get(),
+    };
+    const std::array<double, 9> samples = {
+        minimum,
+        -0.001,
+        0.0,
+        0.01,
+        1.0,
+        80.0,
+        125.0,
+        200.0,
+        maximum,
+    };
+    for (const double sample : samples) {
+        QVector3D actual(sample, sample, sample);
+        for (const auto operation : hardware) {
+            for (const auto &programmed : operation->m_programmed) {
+                actual = ColorOp::applyOperation(programmed, actual);
+            }
+        }
+        const QVector3D expected = requested.evaluate(QVector3D(sample, sample, sample));
+        QVERIFY2((actual - expected).length() < 0.00001,
+                 qPrintable(QStringLiteral("sample %1: actual %2, expected %3")
+                                .arg(sample, 0, 'f', 9)
+                                .arg(actual.x(), 0, 'f', 9)
+                                .arg(expected.x(), 0, 'f', 9)));
+    }
+
+    gpu.reset();
+    verifyCleanup(mockGpu.get());
+}
+
 QTEST_GUILESS_MAIN(DrmTest)
