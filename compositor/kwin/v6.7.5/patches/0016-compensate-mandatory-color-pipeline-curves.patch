+static std::optional<std::pair<TransferFunction::Type, bool>> pickSupportedFunction(DrmEnumProperty<Named1DLutType> *property)
+{
+    // Color pipeline descriptions normally expose only one choice per mandatory
+    // named curve. Keep the order deterministic if a driver exposes more.
+    if (property->hasEnum(Named1DLutType::PQ_125)) {
+        return std::make_pair(TransferFunction::PerceptualQuantizer, false);
+    } else if (property->hasEnum(Named1DLutType::PQ_125_Inverse)) {
+        return std::make_pair(TransferFunction::PerceptualQuantizer, true);
+    } else if (property->hasEnum(Named1DLutType::sRGB)) {
+        return std::make_pair(TransferFunction::sRGB, false);
+    } else if (property->hasEnum(Named1DLutType::sRGB_Inverse)) {
+        return std::make_pair(TransferFunction::sRGB, true);
+    } else if (property->hasEnum(Named1DLutType::gamma22)) {
+        return std::make_pair(TransferFunction::gamma22, false);
+    } else if (property->hasEnum(Named1DLutType::gamma22_Inverse)) {
+        return std::make_pair(TransferFunction::gamma22, true);
+    }
+    return std::nullopt;
+}
+
+static double namedTransferFunctionScale(TransferFunction::Type type)
+{
+    // DRM's PQ 125 curve maps code value 1 to 125. The other named curves are
+    // normalized to one. DrmNamed1DLut::inputScaling/outputScaling use the same
+    // convention.
+    return type == TransferFunction::PerceptualQuantizer ? 125.0 : 1.0;
+}
+
+std::optional<DrmAbstractColorOp::Scaling> DrmNamed1DLut::bypassScaling(const ColorOp &nextOperation) const
+{
+    const auto function = pickSupportedFunction(m_value);
+    if (!function) {
+        return std::nullopt;
+    }
+    const auto [type, inverse] = *function;
+    const double scale = namedTransferFunctionScale(type);
+    if (!inverse && (nextOperation.input.min < -ColorPipeline::s_maxResolution || nextOperation.input.max > 1.0 + ColorPipeline::s_maxResolution)) {
+        // An EOTF cannot losslessly consume values outside its encoded domain.
+        return std::nullopt;
+    }
+    if (inverse && nextOperation.input.max - nextOperation.input.min < ColorPipeline::s_maxResolution) {
+        return std::nullopt;
+    }
+
+    // For inverse curves, describe the transfer function with the actual input
+    // range. inputScaling() then folds the normalization required by the fixed
+    // DRM curve into an earlier programmable block. This preserves negative
+    // minima and ranges larger than PQ 125 without clipping.
+    const TransferFunction transfer(type,
+                                    inverse ? nextOperation.input.min : 0.0,
+                                    inverse ? nextOperation.input.max : scale);
+    const ValueRange hardwareOutput{
+        .min = inverse ? transfer.nitsToEncoded(nextOperation.input.min) : transfer.encodedToNits(nextOperation.input.min),
+        .max = inverse ? transfer.nitsToEncoded(nextOperation.input.max) : transfer.encodedToNits(nextOperation.input.max),
+    };
+    return Scaling{
+        .scaling = inverse ? ColorOp::Operation(InverseColorTransferFunction(transfer)) : ColorOp::Operation(ColorTransferFunction(transfer)),
+        .inverse = ColorOp{
+            .input = hardwareOutput,
+            .inputSpace = inverse ? ColorspaceType::NonLinearRGB : ColorspaceType::LinearRGB,
+            .operation = inverse ? ColorOp::Operation(ColorTransferFunction(transfer)) : ColorOp::Operation(InverseColorTransferFunction(transfer)),
+            .output = nextOperation.input,
+            .outputSpace = nextOperation.inputSpace,
+        },
+    };
+}
+
+std::optional<DrmAbstractColorOp::Scaling> DrmNamed1DLut::bypassOutputScaling(const ColorOp &lastAppliedOp) const
+{
+    const auto function = pickSupportedFunction(m_value);
+    if (!function) {
+        return std::nullopt;
+    }
+    const auto [type, inverse] = *function;
+    const double scale = namedTransferFunctionScale(type);
+    const double maximumOutput = inverse ? 1.0 : scale;
+    if (lastAppliedOp.output.min < -ColorPipeline::s_maxResolution || lastAppliedOp.output.max > maximumOutput + ColorPipeline::s_maxResolution) {
+        // There is no later block in this path to restore values clipped by the
+        // mandatory transfer function.
+        return std::nullopt;
+    }
+
+    const TransferFunction transfer(type, 0.0, scale);
+    const ValueRange hardwareInput{
+        .min = inverse ? transfer.encodedToNits(lastAppliedOp.output.min) : transfer.nitsToEncoded(lastAppliedOp.output.min),
+        .max = inverse ? transfer.encodedToNits(lastAppliedOp.output.max) : transfer.nitsToEncoded(lastAppliedOp.output.max),
+    };
+    return Scaling{
+        .scaling = inverse ? ColorOp::Operation(InverseColorTransferFunction(transfer)) : ColorOp::Operation(ColorTransferFunction(transfer)),
+        .inverse = ColorOp{
+            .input = lastAppliedOp.output,
+            .inputSpace = lastAppliedOp.outputSpace,
+            .operation = inverse ? ColorOp::Operation(ColorTransferFunction(transfer)) : ColorOp::Operation(InverseColorTransferFunction(transfer)),
+            .output = hardwareInput,
+            .outputSpace = inverse ? ColorspaceType::LinearRGB : ColorspaceType::NonLinearRGB,
+        },
+    };
+}
