+
+class TestColorOp : public DrmAbstractColorOp
+{
+public:
+    enum class Kind {
+        Matrix,
+        Lut,
+        PqEotf,
+        PqInverseEotf,
+    };
+
+    TestColorOp(DrmAbstractColorOp *next, Kind kind, Features features)
+        : DrmAbstractColorOp(next, features, QStringLiteral("test color op"))
+        , m_kind(kind)
+    {
+    }
+
+    std::optional<Priority> colorOpPreference(const ColorOp::Operation &op) override
+    {
+        switch (m_kind) {
+        case Kind::Matrix:
+            if (std::holds_alternative<ColorMatrix>(op) || std::holds_alternative<ColorMultiplier>(op)) {
+                return Priority::Normal;
+            }
+            break;
+        case Kind::Lut:
+            if (std::holds_alternative<ColorTransferFunction>(op) || std::holds_alternative<InverseColorTransferFunction>(op)) {
+                return Priority::Normal;
+            }
+            break;
+        case Kind::PqEotf:
+            if (const auto tf = std::get_if<ColorTransferFunction>(&op); tf && tf->tf.type == TransferFunction::PerceptualQuantizer) {
+                return Priority::High;
+            }
+            break;
+        case Kind::PqInverseEotf:
+            if (const auto tf = std::get_if<InverseColorTransferFunction>(&op); tf && tf->tf.type == TransferFunction::PerceptualQuantizer) {
+                return Priority::High;
+            }
+            break;
+        }
+        return std::nullopt;
+    }
+
+    void program(DrmAtomicCommit *commit, const std::deque<ColorOp::Operation> &operations) override
+    {
+        if (m_kind == Kind::PqEotf || m_kind == Kind::PqInverseEotf) {
+            const auto curve = std::ranges::find_if(operations, [](const ColorOp::Operation &operation) {
+                return std::holds_alternative<ColorTransferFunction>(operation)
+                    || std::holds_alternative<InverseColorTransferFunction>(operation);
+            });
+            if (curve != operations.end()) {
+                // Named DRM curves select a fixed hardware function; their
+                // luminance parameters are not programmable. Mirror the PQ
+                // 125 behavior of DrmNamed1DLut::program().
+                const TransferFunction fixedPq(TransferFunction::PerceptualQuantizer, 0, 125);
+                m_programmed.push_back(m_kind == Kind::PqEotf
+                                           ? ColorOp::Operation(ColorTransferFunction(fixedPq))
+                                           : ColorOp::Operation(InverseColorTransferFunction(fixedPq)));
+            }
+        } else {
+            m_programmed = operations;
+        }
+    }
+
+    void bypass(DrmAtomicCommit *commit) override
+    {
+        m_bypassed = true;
+        m_invalidBypass = !canBypass();
+    }
+
+    std::optional<Scaling> inputScaling(const ColorOp &op) const override
+    {
+        if (m_kind != Kind::PqInverseEotf) {
+            return std::nullopt;
+        }
+        const auto tf = std::get_if<InverseColorTransferFunction>(&op.operation);
+        if (!tf) {
+            return std::nullopt;
+        }
+        QMatrix4x4 matrix;
+        matrix.scale(125.0);
+        matrix.scale(1.0 / (tf->tf.maxLuminance - tf->tf.minLuminance));
+        matrix.translate(-tf->tf.minLuminance, -tf->tf.minLuminance, -tf->tf.minLuminance);
+        const auto normalized = matrix.map(QVector3D(op.input.min, op.input.max, 0));
+        return Scaling{
+            .scaling = ColorMatrix(matrix.inverted()),
+            .inverse = ColorOp{
+                .input = op.input,
+                .inputSpace = op.inputSpace,
+                .operation = ColorMatrix(matrix),
+                .output = ValueRange{.min = normalized.x(), .max = normalized.y()},
+                .outputSpace = ColorspaceType::AnyNonRGB,
+            },
+        };
+    }
+
+    std::optional<Scaling> bypassScaling(const ColorOp &nextOperation) const override
+    {
+        if (m_kind != Kind::PqInverseEotf) {
+            return std::nullopt;
+        }
+        const TransferFunction transfer(TransferFunction::PerceptualQuantizer, nextOperation.input.min, nextOperation.input.max);
+        return Scaling{
+            .scaling = InverseColorTransferFunction(transfer),
+            .inverse = ColorOp{
+                .input = ValueRange{.min = 0, .max = 1},
+                .inputSpace = ColorspaceType::NonLinearRGB,
+                .operation = ColorTransferFunction(transfer),
+                .output = nextOperation.input,
+                .outputSpace = nextOperation.inputSpace,
+            },
+        };
+    }
+
+    std::optional<Scaling> bypassOutputScaling(const ColorOp &lastAppliedOp) const override
+    {
+        if (m_kind != Kind::PqEotf || lastAppliedOp.output.min < 0 || lastAppliedOp.output.max > 125) {
+            return std::nullopt;
+        }
+        const TransferFunction transfer(TransferFunction::PerceptualQuantizer, 0, 125);
+        return Scaling{
+            .scaling = ColorTransferFunction(transfer),
+            .inverse = ColorOp{
+                .input = lastAppliedOp.output,
+                .inputSpace = lastAppliedOp.outputSpace,
+                .operation = InverseColorTransferFunction(transfer),
+                .output = ValueRange{
+                    .min = transfer.nitsToEncoded(lastAppliedOp.output.min),
+                    .max = transfer.nitsToEncoded(lastAppliedOp.output.max),
+                },
+                .outputSpace = ColorspaceType::NonLinearRGB,
+            },
+        };
+    }
+
+    Kind m_kind;
+    std::deque<ColorOp::Operation> m_programmed;
+    bool m_bypassed = false;
+    bool m_invalidBypass = false;
 };
 
