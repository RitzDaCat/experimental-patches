+bool ItemRendererOpenGL::colorTransformIsIdentity(const std::shared_ptr<ColorDescription> &source, const std::shared_ptr<ColorDescription> &destination, RenderingIntent intent, ColorPipeline::InputType inputType)
+{
+    for (const ColorTransformCacheEntry &entry : m_colorTransformCache) {
+        if (entry.valid
+            && entry.source.get() == source.get()
+            && entry.destination.get() == destination.get()
+            && entry.intent == intent
+            && entry.inputType == inputType) {
+            return entry.isIdentity;
+        }
