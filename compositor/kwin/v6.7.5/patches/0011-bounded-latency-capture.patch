+void DrmCommitThread::writeCommitTelemetry(const PendingCommitTelemetry &sample, bool success, std::chrono::nanoseconds pageflipTimestamp, TimePoint callbackTime)
+{
+    if (!m_latencyOutput) {
+        return;
+    }
+    const bool periodicSample = sample.sequence == 1 || sample.sequence % 16 == 0;
+    const bool exceptionalSample = !success || sample.readinessRetries != 0 || sample.queueDepth > 1;
+    if (!periodicSample && !exceptionalSample) {
+        return;
+    }
+    *m_latencyOutput << sample.sequence << "," << sample.target.time_since_epoch().count() << "," << sample.submitStart.time_since_epoch().count() << "," << sample.submitEnd.time_since_epoch().count()
