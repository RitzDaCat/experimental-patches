+// 0 = stock, 1 = shadow (learn but don't apply), 2 = adaptive (default).
+static const int s_renderBudgetMode = s_experimentKernelAllowed ? std::clamp(environmentVariableIntValue("KWIN_ADAPTIVE_RENDER_BUDGET").value_or(2), 0, 2) : 0;
