     void scheduleNextRepaint(std::optional<std::chrono::steady_clock::time_point> presentNotBefore);
     void scheduleRepaint(std::chrono::nanoseconds lastTargetTimestamp, std::chrono::nanoseconds presentNotBefore);
 
@@ -46,6 +49,11 @@ public:
     std::chrono::nanoseconds desiredWakeTimestamp = std::chrono::nanoseconds::zero();
     std::chrono::nanoseconds armedWakeTimestamp = std::chrono::nanoseconds::zero();
     std::chrono::nanoseconds actualWakeTimestamp = std::chrono::nanoseconds::zero();
+    std::chrono::nanoseconds appliedSchedulerMargin = std::chrono::nanoseconds::zero();
+    std::chrono::nanoseconds adaptiveSchedulerMargin = std::chrono::nanoseconds::zero();
+    std::chrono::nanoseconds adaptiveWakeWindowPeak = std::chrono::nanoseconds::zero();
+    unsigned int adaptiveCleanWakeCount = 0;
+    bool wakeSampleValid = false;
     bool wasTripleBuffering = false;
     int doubleBufferingCounter = 0;
     PreciseTimer compositeTimer;
