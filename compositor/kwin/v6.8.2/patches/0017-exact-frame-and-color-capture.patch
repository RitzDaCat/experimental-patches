+static bool colorMatchCaptureEnabled()
+{
+    if (qEnvironmentVariableIntValue("KWIN_LATENCY_CAPTURE") != 1) {
+        return false;
+    }
+    const QByteArray expectedRelease = qgetenv("KWIN_COMPOSITOR_EXPERIMENT_KERNEL_RELEASE");
+    struct utsname systemInfo;
+    return !expectedRelease.isEmpty() && uname(&systemInfo) == 0 && expectedRelease == systemInfo.release;
+}
+
+static const bool s_colorMatchCaptureEnabled = colorMatchCaptureEnabled();
+static std::optional<std::fstream> s_colorMatchTelemetry;
+static uint64_t s_colorMatchSequence = 0;
+
+template<typename T>
+static QString describeColorMatchValue(const T &value)
+{
+    QString result;
+    QDebug debug(&result);
+    debug.noquote().nospace() << value;
+    return result;
+}
+
+static void writeColorMatchTelemetry(DrmAbstractColorOp *first, const ColorPipeline &pipeline,
+                                     const std::optional<Assignments> &assignments,
+                                     std::chrono::nanoseconds matchDuration)
+{
+    if (!s_colorMatchCaptureEnabled) {
+        return;
+    }
+    if (!s_colorMatchTelemetry) {
+        s_colorMatchTelemetry.emplace("kwin drm color match.log", std::ios::out);
+    }
+    const auto timestamp = std::chrono::steady_clock::now().time_since_epoch().count();
+    *s_colorMatchTelemetry
+        << "record=" << ++s_colorMatchSequence << " timestamp_ns=" << timestamp
+        << " duration_ns=" << matchDuration.count()
+        << " matched=" << (assignments && !assignments->nextInverseInputScaling ? 1 : 0)
+        << " residual_inverse_scaling=" << (assignments && assignments->nextInverseInputScaling ? 1 : 0)
+        << " compensated_non_bypassable=" << (assignments && assignments->compensatedNonBypassable ? 1 : 0)
+        << "\nrequested_pipeline=" << qPrintable(describeColorMatchValue(pipeline)) << "\n";
+    size_t hardwareIndex = 0;
+    for (auto *hardwareOp = first; hardwareOp; hardwareOp = hardwareOp->next(), ++hardwareIndex) {
+        *s_colorMatchTelemetry
+            << "hardware[" << hardwareIndex << "]=" << qPrintable(hardwareOp->name())
+            << " bypass_capable=" << (hardwareOp->canBypass() ? 1 : 0);
+        if (assignments) {
+            const auto assignment = assignments->assignments.find(hardwareOp);
+            if (assignment != assignments->assignments.end()) {
+                *s_colorMatchTelemetry << " assigned_operations=" << assignment->second.size() << "\n";
+                size_t operationIndex = 0;
+                for (const auto &operation : assignment->second) {
+                    const ColorOp describedOperation{
+                        .input = ValueRange{},
+                        .inputSpace = ColorspaceType::AnyNonRGB,
+                        .operation = operation,
+                        .output = ValueRange{},
+                        .outputSpace = ColorspaceType::AnyNonRGB,
+                    };
+                    *s_colorMatchTelemetry
+                        << "  operation[" << operationIndex++ << "]="
+                        << qPrintable(describeColorMatchValue(describedOperation)) << "\n";
+                }
+                continue;
+            }
+        }
+        *s_colorMatchTelemetry << " assigned_operations=0\n";
+    }
+    *s_colorMatchTelemetry << "end_record\n";
+    s_colorMatchTelemetry->flush();
+}
