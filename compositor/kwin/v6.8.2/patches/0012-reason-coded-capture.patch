+static DirectScanoutTelemetryReason directScanoutTelemetryReason(DirectScanoutCheckResult result)
+{
+    switch (result) {
+    case DirectScanoutCheckResult::Passed:
+        return DirectScanoutTelemetryReason::Accepted;
+    case DirectScanoutCheckResult::Disabled:
+        return DirectScanoutTelemetryReason::ScanoutDisabled;
+    case DirectScanoutCheckResult::NonPrimaryPlaneDisabled:
+        return DirectScanoutTelemetryReason::NonPrimaryPlaneDisabled;
+    case DirectScanoutCheckResult::ModesetPending:
+        return DirectScanoutTelemetryReason::ModesetPending;
+    case DirectScanoutCheckResult::ShadowBufferRequired:
+        return DirectScanoutTelemetryReason::ShadowBufferRequired;
+    case DirectScanoutCheckResult::ColorPipelineUnsupported:
+        return DirectScanoutTelemetryReason::ColorPipelineUnsupported;
+    case DirectScanoutCheckResult::FractionalSourceRect:
+        return DirectScanoutTelemetryReason::FractionalSourceRect;
+    case DirectScanoutCheckResult::TransformUnsupported:
+        return DirectScanoutTelemetryReason::TransformUnsupported;
+    case DirectScanoutCheckResult::BackendRejected:
+        return DirectScanoutTelemetryReason::EarlyChecksFailed;
+    }
+    Q_UNREACHABLE();
+}
