@@ -537,6 +565,9 @@ static bool prepareDirectScanout(RenderView *view, LogicalOutput *logicalOutput,
         // - requesting clients to re-allocate from an incompatible device can trigger
         //   driver bugs as well (like rendering freezing on Nvidia, when asked to
         //   re-allocate for an integrated GPU)
+        if (s_latencyCaptureEnabled) {
+            frame->recordDirectScanout(DirectScanoutTelemetryReason::CrossDeviceBuffer);
+        }
         return false;
     }
 
@@ -549,9 +580,10 @@ static bool prepareDirectScanout(RenderView *view, LogicalOutput *logicalOutput,
     layer->setBufferTransform(candidate->bufferTransform());
     layer->setOffloadTransform(candidate->bufferTransform().combine(backendOutput->transform().inverted()));
     layer->setColor(candidate->colorDescription(), candidate->renderingIntent(), ColorPipeline::create(candidate->colorDescription(), backendOutput->layerBlendingColor(), candidate->renderingIntent(), bufferType));
-    if (!layer->earlyScanoutChecks()) {
