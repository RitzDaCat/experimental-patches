 src/core/renderloop.cpp | 224 ++++++++++++++++++++++++++++++++++++----
 src/core/renderloop_p.h |  20 ++++
 2 files changed, 222 insertions(+), 22 deletions(-)

diff --git a/src/core/renderloop.cpp b/src/core/renderloop.cpp
