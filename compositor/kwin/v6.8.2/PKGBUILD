prepare() {
  # Arch and CachyOS 6.8.2-1 build the pristine tarball with no distribution
  # patches, so the series starts on it. The PreciseTimer timerfd wakeup
  # (former 0001/0002) is part of 6.8. Patch numbers are stable IDs: 0013
  # became obsolete in 6.8 and 0015 waits for a 6.8 benchmark.
  patch -d "$pkgname-$pkgver" -Np1 --batch --forward --fuzz=0 --no-backup-if-mismatch -i "$srcdir/0003-wakeup-instrumentation.patch"
  patch -d "$pkgname-$pkgver" -Np1 --batch --forward --fuzz=0 --no-backup-if-mismatch -i "$srcdir/0004-adaptive-wakeup-margin.patch"
  patch -d "$pkgname-$pkgver" -Np1 --batch --forward --fuzz=0 --no-backup-if-mismatch -i "$srcdir/0005-kernel-release-gate.patch"
  patch -d "$pkgname-$pkgver" -Np1 --batch --forward --fuzz=0 --no-backup-if-mismatch -i "$srcdir/0006-adaptive-margin-v2.patch"
  patch -d "$pkgname-$pkgver" -Np1 --batch --forward --fuzz=0 --no-backup-if-mismatch -i "$srcdir/0007-backends-libinput-add-gated-input-queue-telemetry.patch"
  patch -d "$pkgname-$pkgver" -Np1 --batch --forward --fuzz=0 --no-backup-if-mismatch -i "$srcdir/0008-telemetry-sample-observers-outside-nanosecond-hot-paths.patch"
  patch -d "$pkgname-$pkgver" -Np1 --batch --forward --fuzz=0 --no-backup-if-mismatch -i "$srcdir/0009-adaptive-render-budget.patch"
  patch -d "$pkgname-$pkgver" -Np1 --batch --forward --fuzz=0 --no-backup-if-mismatch -i "$srcdir/0010-vrr-cadence-repaint-coalescing.patch"
  patch -d "$pkgname-$pkgver" -Np1 --batch --forward --fuzz=0 --no-backup-if-mismatch -i "$srcdir/0011-bounded-latency-capture.patch"
  patch -d "$pkgname-$pkgver" -Np1 --batch --forward --fuzz=0 --no-backup-if-mismatch -i "$srcdir/0012-reason-coded-capture.patch"
  patch -d "$pkgname-$pkgver" -Np1 --batch --forward --fuzz=0 --no-backup-if-mismatch -i "$srcdir/0014-fix-inverse-srgb-linear-segment.patch"
  patch -d "$pkgname-$pkgver" -Np1 --batch --forward --fuzz=0 --no-backup-if-mismatch -i "$srcdir/0016-compensate-mandatory-color-pipeline-curves.patch"
  patch -d "$pkgname-$pkgver" -Np1 --batch --forward --fuzz=0 --no-backup-if-mismatch -i "$srcdir/0017-exact-frame-and-color-capture.patch"
  patch -d "$pkgname-$pkgver" -Np1 --batch --forward --fuzz=0 --no-backup-if-mismatch -i "$srcdir/0018-guard-wake-sample-consumption.patch"
  patch -d "$pkgname-$pkgver" -Np1 --batch --forward --fuzz=0 --no-backup-if-mismatch -i "$srcdir/0019-default-low-latency-policy.patch"
  patch -d "$pkgname-$pkgver" -Np1 --batch --forward --fuzz=0 --no-backup-if-mismatch -i "$srcdir/0020-runtime-optin-latency-policy.patch"
  patch -d "$pkgname-$pkgver" -Np1 --batch --forward --fuzz=0 --no-backup-if-mismatch -i "$srcdir/0021-selectable-mandatory-csc-pq-scale.patch"
  patch -d "$pkgname-$pkgver" -Np1 --batch --forward --fuzz=0 --no-backup-if-mismatch -i "$srcdir/0022-precisetimer-clamp-nonpositive-deadline.patch"
}

build() {
  rm -rf build
  # Bake a kernel release into the binary as the default experiment gate
  # (patch 0019 reads this macro), so the low-latency policy holds with no
  # environment.d profile. KWIN_LATENCY_GATE_KERNEL names the kernel that will
  # be booted (kwin-latencyctl build --kernel sets it); the default is the
  # build machine's running kernel. A kernel update still fails closed to
  # stock behaviour until the package is rebuilt.
  export CXXFLAGS="${CXXFLAGS-} -DKWIN_LATENCY_BAKED_KERNEL_RELEASE=\"\\\"${KWIN_LATENCY_GATE_KERNEL:-$(uname -r)}\\\"\""
  cmake -B build -S $pkgname-$pkgver \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DBUILD_TESTING=ON \
    -DKWIN_BUILD_SCREENLOCKER=ON
  cmake --build build

  # rev16 shipped with KWIN_BUILD_SCREENLOCKER=OFF, which drops the
  # KScreenLocker linkage from libkwin. On Wayland ksmserver defers locking to
  # KWin, so nothing then registers org.freedesktop.ScreenSaver and both Meta+L
  # and the "Lock" menu item silently do nothing. Fail the build instead.
  # Read into a variable rather than piping: grep -q exits on first match, which
  # SIGPIPEs objdump, and under `set -o pipefail` that fails the whole pipeline.
  local headers
  headers=$(objdump -p build/bin/libkwin.so.6)
  if ! grep -q libKScreenLocker <<<"$headers"; then
    echo "==> ERROR: libkwin.so.6 is missing libKScreenLocker; lock screen would be broken" >&2
    return 1
  fi
}

check() {
  # Only the tests that cover the patched colour paths run here. 0014 adds
  # testSrgbLinearSegmentRoundtrip to kwin-testColorspaces and 0016 adds
  # testNonBypassableNamedTransferFunctions to kwin-testMockDrm. Both are
  # pure-computation tests, so they run without a display. The rest of the KWin
  # suite needs a live Wayland/X session and cannot run inside a package build.
  ctest --test-dir build --output-on-failure -R '^kwin-testColorspaces$'
  # testMockDrm is run for the one patched function only. Its upstream cases
  # open the real /dev/dri node, and testModeGeneration(1440p) hung for the
  # full 300 s QtTest limit under a live compositor on the 6.7.5-3.1 build.
  # Same working directory as the ctest entry (ecm_add_test sets it).
  (cd build/autotests/drm && ../../bin/testMockDrm testNonBypassableNamedTransferFunctions)
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  setcap CAP_SYS_NICE=+ep "$pkgdir"/usr/bin/kwin_wayland
  # Steam launch options need the per-game wrapper on PATH with no repo
  # checkout, so the package carries it: kwin-latency-game -- %command%
  install -Dm755 "$srcdir/kwin-latency-game" "$pkgdir/usr/bin/kwin-latency-game"
  # alpm hooks that make the two silent-revert paths loud: a kernel upgrade
  # that removes the gate kernel's modules, and any replacement of the kwin
  # package. Package-owned so install and removal track the package itself.
  install -Dm755 "$srcdir/kwin-latency-check-gate.sh" \
    "$pkgdir/usr/lib/kwin-latency/check-gate.sh"
  install -Dm644 "$srcdir/kwin-latency-kernel-gate.hook" \
    "$pkgdir/usr/share/libalpm/hooks/kwin-latency-kernel-gate.hook"
  install -Dm644 "$srcdir/kwin-latency-kwin-replaced.hook" \
    "$pkgdir/usr/share/libalpm/hooks/kwin-latency-kwin-replaced.hook"
}
