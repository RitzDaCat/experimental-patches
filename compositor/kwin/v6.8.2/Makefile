.PHONY: help status install enable esports disable test snapshot build rollback remove

CTL := ./bin/kwin-latencyctl

help:
	@$(CTL) help

status:
	@$(CTL) status

install:
	@$(CTL) install

enable:
	@$(CTL) enable

esports:
	@$(CTL) esports

disable:
	@$(CTL) disable

test:
	@$(CTL) test

snapshot:
	@$(CTL) snapshot manual

build:
	@$(CTL) build

rollback:
	@$(CTL) rollback

remove:
	@$(CTL) remove
